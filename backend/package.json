{
  "name": "roysti-api",
  "version": "0.1.0",
  "private": true,
  "description": "API Roysti : agent d'achat pour Taobao, Tmall, 1688, Alibaba, JD et Weidian",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
